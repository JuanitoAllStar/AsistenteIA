<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AsistenteIA.Views.DetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalle">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Label Text="Consulta" FontAttributes="Bold" FontSize="18"
                   SemanticProperties.HeadingLevel="Level2" />
            <Label Text="{Binding Record.Prompt}" />

            <Label Text="Respuesta" FontAttributes="Bold" FontSize="18"
                   SemanticProperties.HeadingLevel="Level2" />
            <Label Text="{Binding Record.Answer}" />

            <Label Text="{Binding Record.CreatedLocal, StringFormat='Fecha: {0}'}" />
            <Label Text="{Binding Record.Category, StringFormat='Categoría: {0}'}" />
            <Label Text="{Binding Record.VerifiedText, StringFormat='Estado: {0}'}" FontAttributes="Bold" />

            <Button Text="Marcar / desmarcar como verificada"
                    Command="{Binding ToggleVerifiedCommand}"
                    SemanticProperties.Hint="Cambia el estado de verificación de la respuesta" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
